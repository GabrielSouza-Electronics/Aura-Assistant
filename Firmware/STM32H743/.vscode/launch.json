{
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "AuraAssistant: Debug internal flash",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "serverInterface": "SWD",
            "serverInterfaceFrequency": "24000",
            "serverPendingHaltTimeout": "15",
            "faultHaltOnException": true,
            "faultDivByZero": true,
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/AuraAssistant_Internal.elf",
                    "symbolFileName": "${workspaceFolder}/build/Debug/AuraAssistant.elf"
                }
            ]
        }
    ]
}
